# Production Server
NODE_ENV=production
PORT=4000
APP_NAME=Kajer Manus
WEBSITE_URL=https://www.kajermanus.in
API_URL=https://api.kajermanus.in
CORS_ORIGINS=https://www.kajermanus.in,https://kajermanus.in

# PostgreSQL (Hostinger VPS)
DATABASE_URL=postgresql://kajermanus_user:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/kajermanus_db
PGSSL=false

# JWT & Cookies
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_HEX_SECRET
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=.kajermanus.in

# SMTP Email (for OTP & Bilingual Notifications)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@kajermanus.in
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM="Kajer Manus <noreply@kajermanus.in>"

# Firebase Admin SDK (USED ONLY FOR FCM PUSH NOTIFICATIONS)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Bootstrap (optional; server-side RBAC governs admin access; run `npm run create-admin` or `npm run migrate`)
INITIAL_ADMIN_EMAIL=admin@kajermanus.in
INITIAL_ADMIN_PASSWORD=

# Admin 2FA Secret Encryption (optional 32+ char key; falls back to derived JWT_SECRET if blank)
TOTP_ENCRYPTION_KEY=

# Razorpay Payment Gateway (Server-side only — NEVER expose KEY_SECRET or WEBHOOK_SECRET to clients)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Mobile OTP SMS Gateway (Optional HTTP webhook for SMS OTP delivery, e.g., MSG91 / Fast2SMS / Twilio bridge)
SMS_PROVIDER_URL=
SMS_API_KEY=
SMS_SENDER_ID=KAJERM

# File Uploads (stored safely outside web root or served via Express /uploads)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
