{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Kajer Manush user account profile and synchronized bilingual preference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "fullName": { "type": "string", "description": "Full name of the user." },
        "email": { "type": "string", "description": "Verified email address." },
        "mobileNumber": { "type": "string", "description": "Mobile phone number." },
        "fullAddress": { "type": "string", "description": "Full residential address." },
        "accountRole": { "type": "string", "enum": ["customer", "provider"], "description": "Selected non-admin role." },
        "languagePreference": { "type": "string", "enum": ["bn", "en"], "description": "Preferred UI & notification language (default bn)." },
        "bengaliNumerals": { "type": "boolean", "description": "Whether Bengali numerals are displayed in Bengali mode." },
        "pushNotificationsEnabled": { "type": "boolean", "description": "Whether push notification alerts are enabled." },
        "emailNotificationsEnabled": { "type": "boolean", "description": "Whether transactional email templates are enabled." },
        "profileCompleted": { "type": "boolean", "description": "Whether registration details have been filled." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp via FieldValue.serverTimestamp()." }
      },
      "required": [
        "userId",
        "fullName",
        "email",
        "mobileNumber",
        "fullAddress",
        "accountRole",
        "languagePreference",
        "bengaliNumerals",
        "pushNotificationsEnabled",
        "emailNotificationsEnabled",
        "profileCompleted",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted admin grant document keyed by UID.",
      "type": "object",
      "properties": {
        "grantedAt": { "type": "string", "format": "date-time", "description": "Server timestamp." }
      }
    },
    "ServiceOffering": {
      "title": "ServiceOffering",
      "description": "Bilingual home service listing with independent Bengali and English titles and descriptions.",
      "type": "object",
      "properties": {
        "categoryKey": { "type": "string", "enum": ["electrician", "plumber", "ac_repair", "home_cleaning", "carpenter", "painter", "appliance_repair", "gardening"] },
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "descriptionBn": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "providerNameBn": { "type": "string" },
        "providerNameEn": { "type": "string" },
        "providerAreaBn": { "type": "string" },
        "providerAreaEn": { "type": "string" },
        "providerId": { "type": "string" },
        "basePriceInr": { "type": "integer" },
        "durationMinutes": { "type": "integer" },
        "rating": { "type": "number" },
        "active": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "categoryKey",
        "titleBn",
        "titleEn",
        "descriptionBn",
        "descriptionEn",
        "providerNameBn",
        "providerNameEn",
        "providerAreaBn",
        "providerAreaEn",
        "providerId",
        "basePriceInr",
        "durationMinutes",
        "rating",
        "active",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceBooking": {
      "title": "ServiceBooking",
      "description": "Bilingual customer booking with status tracking.",
      "type": "object",
      "properties": {
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "serviceAddress": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceTitleBn": { "type": "string" },
        "serviceTitleEn": { "type": "string" },
        "categoryKey": { "type": "string" },
        "providerId": { "type": "string" },
        "providerNameBn": { "type": "string" },
        "providerNameEn": { "type": "string" },
        "scheduledDate": { "type": "string" },
        "scheduledSlot": { "type": "string" },
        "amountInr": { "type": "integer" },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "accepted", "rejected", "in_progress", "completed", "cancelled"] },
        "languageAtBooking": { "type": "string", "enum": ["bn", "en"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "customerId",
        "customerName",
        "customerPhone",
        "serviceAddress",
        "serviceId",
        "serviceTitleBn",
        "serviceTitleEn",
        "categoryKey",
        "providerId",
        "providerNameBn",
        "providerNameEn",
        "scheduledDate",
        "scheduledSlot",
        "amountInr",
        "notes",
        "status",
        "languageAtBooking",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Bilingual user notification generated according to saved language preference.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "titleBn": { "type": "string" },
        "titleEn": { "type": "string" },
        "bodyBn": { "type": "string" },
        "bodyEn": { "type": "string" },
        "bookingId": { "type": "string" },
        "type": { "type": "string", "enum": ["booking_created", "booking_status", "security", "system"] },
        "readFlag": { "type": "boolean" },
        "languageCode": { "type": "string", "enum": ["bn", "en"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "titleBn",
        "titleEn",
        "bodyBn",
        "bodyEn",
        "bookingId",
        "type",
        "readFlag",
        "languageCode",
        "createdAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Bilingual customer/provider support inquiry submitted via Contact Form.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "languageCode": { "type": "string", "enum": ["bn", "en"] },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "subject",
        "message",
        "languageCode",
        "status",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and language preference document."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin UID registry."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/ServiceOffering" },
      "description": "Bilingual service marketplace catalog."
    },
    "/bookings/{bookingId}": {
      "schema": { "$ref": "#/entities/ServiceBooking" },
      "description": "Service bookings connecting customers and providers."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "Per-user bilingual notifications."
    },
    "/users/{userId}/support_tickets/{ticketId}": {
      "schema": { "$ref": "#/entities/SupportTicket" },
      "description": "Per-user support contact form tickets."
    }
  }
}
